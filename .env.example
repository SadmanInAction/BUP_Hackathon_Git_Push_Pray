# Copy to .env and fill in. Never commit .env.
# Required: Groq API key (free at https://console.groq.com, no card needed)
GROQ_API_KEY=
# Optional: comma-separated Groq models tried in order (default below)
# GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# Optional extra fallback provider (free at https://aistudio.google.com)
# GEMINI_API_KEY=
# PORT=8000
